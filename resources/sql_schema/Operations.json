{
  "$defs": {
    "CtPackageType": {
      "description": "Standard whose CT packages to use (constants/standard_package_mappings.py); case-insensitive",
      "enum": ["ADAM", "ADAMIG", "CDASHIG", "SDTM", "SDTMIG", "SENDIG", "USDM"],
      "type": "string"
    }
  },
  "$id": "Operations.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["attribute_name"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": [
              "define_variable_metadata",
              "get_countries",
              "label_referenced_variable_metadata",
              "name_referenced_variable_metadata"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["case_sensitive"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": ["define_extended_terms_in_ct", "intersect", "minus"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["codelist"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": ["get_countries"]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": ["ct_attribute"]
          },
          {
            "required": ["ct_conditions"]
          }
        ]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": ["get_codelist_attributes"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["ct_package_types"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": ["valid_codelist_dates"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["domain_class"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": ["standard_domains"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["external_dictionary_type"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": [
              "get_define_external_dictionary_version",
              "get_external_dictionary_version"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["filter"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": [
              "distinct",
              "max",
              "max_date",
              "mean",
              "min",
              "min_date",
              "record_count",
              "split"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["group"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": [
              "distinct",
              "max",
              "max_date",
              "mean",
              "min",
              "min_date",
              "record_count"
            ]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": ["ignore_empty_filtered_groups"]
          },
          {
            "required": ["regex"]
          }
        ]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": [
              "max",
              "max_date",
              "mean",
              "min",
              "min_date",
              "record_count"
            ]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": ["key_name"]
          },
          {
            "required": ["key_value"]
          }
        ]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": [
              "get_column_order_from_library",
              "get_model_filtered_variables"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["subtract"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": ["intersect", "minus"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["use_rule_type_table"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": [
              "max",
              "max_date",
              "mean",
              "min",
              "min_date",
              "record_count",
              "variable_is_null"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["value"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": ["calc"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["version"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": ["define_extended_terms_in_ct", "get_codelist_attributes"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["regex"]
      },
      "then": {
        "required": ["name"]
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "type": "array"
          }
        },
        "required": ["name"]
      },
      "then": {
        "properties": {
          "operator": {
            "enum": ["intersect", "minus"]
          }
        }
      }
    }
  ],
  "anyOf": [
    {
      "properties": {
        "operator": {
          "const": "calc"
        }
      },
      "required": ["id", "operator", "value"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "dataset_names"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "define_extended_terms_in_ct"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "define_variable_metadata"
        }
      },
      "required": ["id", "operator", "attribute_name", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "distinct"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "domain_is_custom"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "domain_label"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "dy"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "expected_variables"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "extract_metadata"
        },
        "name": {
          "description": "dataset_name / dataset_size describe the dataset itself; the others are read from the IG library's domain metadata",
          "enum": [
            "dataset_name",
            "dataset_size",
            "datasetStructure",
            "description",
            "label"
          ]
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "get_codelist_attributes"
        }
      },
      "required": ["id", "operator", "ct_attribute"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "get_column_order_from_dataset"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "get_column_order_from_library"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "get_countries"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "get_define_external_dictionary_version"
        }
      },
      "required": ["id", "operator", "external_dictionary_type"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "get_external_dictionary_version"
        },
        "external_dictionary_type": {
          "description": "WHODrug versions are not available",
          "enum": ["meddra", "medrt", "loinc", "snomed", "unii"]
        }
      },
      "required": ["id", "operator", "external_dictionary_type"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "get_model_column_order"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "get_model_filtered_variables"
        }
      },
      "required": ["id", "operator", "key_name", "key_value"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "get_parent_model_column_order"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "intersect"
        }
      },
      "required": ["id", "operator", "name", "subtract"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "label_referenced_variable_metadata"
        },
        "attribute_name": {
          "enum": ["core", "label", "name", "ordinal", "role", "simpleDatatype"]
        }
      },
      "required": ["id", "operator", "attribute_name", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "max"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "max_date"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "mean"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "min"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "min_date"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "minus"
        }
      },
      "required": ["id", "operator", "name", "subtract"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "name_referenced_variable_metadata"
        },
        "attribute_name": {
          "enum": ["core", "label", "name", "ordinal", "role", "simpleDatatype"]
        }
      },
      "required": ["id", "operator", "attribute_name", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "permissible_variables"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "record_count"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "referenced_domain_variable_names"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "required_variables"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "split"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "standard_domains"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "study_domains"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "valid_codelist_dates"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "variable_count"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "variable_exists"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "variable_is_null"
        }
      },
      "required": ["id", "operator", "name"],
      "type": "object"
    },
    {
      "properties": {
        "operator": {
          "const": "whodrug_code_hierarchy"
        }
      },
      "required": ["id", "operator"],
      "type": "object"
    }
  ],
  "properties": {
    "id": {
      "$ref": "CORE-base.json#/$defs/OperationResultId"
    },
    "operator": {
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "Target variable. minus / intersect also accept a list of literal values"
    },
    "domain": {
      "anyOf": [
        {
          "$ref": "CORE-base.json#/$defs/Dataset"
        },
        {
          "$ref": "CORE-base.json#/$defs/DataStructure"
        },
        {
          "enum": [
            "cg_taugs",
            "ex_loinc",
            "ex_meddra",
            "ex_medrt",
            "ex_snomed",
            "ex_unii",
            "ex_whodrug",
            "fda_submission_standards",
            "global_value_check",
            "ig_codelists",
            "ig_datasets",
            "ig_variables"
          ],
          "description": "Engine helper table, or the table built by the Global Value Check rule type"
        }
      ]
    },
    "group": {
      "items": {
        "anyOf": [
          {
            "$ref": "CORE-base.json#/$defs/VariableReference"
          },
          {
            "$ref": "MetaVariables.json"
          }
        ]
      },
      "type": "array"
    },
    "filter": {
      "type": "object"
    },
    "regex": {
      "type": "string"
    },
    "ignore_empty_filtered_groups": {
      "type": "boolean"
    },
    "use_rule_type_table": {
      "type": "boolean"
    },
    "value": {
      "type": "string",
      "description": "calc formula"
    },
    "subtract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "Variable, list of literal values or previous operation result to compare against"
    },
    "case_sensitive": {
      "type": "boolean"
    },
    "attribute_name": {
      "anyOf": [
        {
          "$ref": "MetaVariables.json"
        },
        {
          "enum": ["country_name", "alpha_2", "alpha_3"],
          "description": "get_countries attribute"
        },
        {
          "description": "Library variable attribute (label_ / name_referenced_variable_metadata)",
          "enum": ["core", "label", "name", "ordinal", "role", "simpleDatatype"]
        }
      ]
    },
    "codelist": {
      "type": "string"
    },
    "domain_class": {
      "type": "string"
    },
    "key_name": {
      "enum": [
        "definition",
        "examples",
        "label",
        "name",
        "notes",
        "ordinal",
        "role",
        "simpleDatatype",
        "variableCcode"
      ],
      "type": "string"
    },
    "key_value": {
      "type": "string"
    },
    "ct_attribute": {
      "enum": [
        "Standard Type",
        "Version Date",
        "Term CCODE",
        "Codelist Code",
        "Extensible",
        "Codelist Name",
        "Term Signification",
        "Synonyms",
        "Definition",
        "Term",
        "Standard and Date"
      ],
      "type": "string"
    },
    "ct_conditions": {
      "items": {
        "additionalProperties": {
          "type": ["string", "null"]
        },
        "propertyNames": {
          "enum": [
            "Standard Type",
            "Version Date",
            "Term CCODE",
            "Codelist Code",
            "Extensible",
            "Codelist Name",
            "Term Signification",
            "Synonyms",
            "Definition",
            "Term",
            "Standard and Date"
          ]
        },
        "type": "object"
      },
      "type": "array"
    },
    "ct_package_types": {
      "items": {
        "$ref": "Operations.json#/$defs/CtPackageType"
      },
      "type": "array"
    },
    "version": {
      "type": "string",
      "description": "CT version, or a variable holding the CT version"
    },
    "external_dictionary_type": {
      "enum": ["meddra", "whodrug", "medrt", "loinc", "snomed", "unii"]
    }
  },
  "required": ["id", "operator"],
  "type": "object"
}
